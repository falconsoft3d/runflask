# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-value
FLASK_ENV=development
DATABASE_URL=sqlite:///runflask.db

# --- Encriptacion de tokens de GitHub (clave Fernet, generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
FERNET_KEY=

# --- GitHub OAuth App (crear en https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# URL publica de callback registrada en la OAuth App
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/github/callback
# URL publica que GitHub usara para enviar los webhooks de push (debe ser accesible desde internet, p.ej. via ngrok)
PUBLIC_WEBHOOK_BASE_URL=http://localhost:5000

# --- Dominio base para los subdominios de proyectos (prototipo local) ---
BASE_DOMAIN=localhost
PROXY_PORT=8080

# --- Rango de puertos internos asignados a los contenedores de los proyectos ---
DEPLOY_PORT_RANGE_START=20000
DEPLOY_PORT_RANGE_END=21000
